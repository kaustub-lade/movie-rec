# ---------------------------------------------------------------------------
# Movie Recommender System - copy this file to `.env` and fill in your values.
# Never commit the real `.env`; it is listed in .gitignore.
# ---------------------------------------------------------------------------

# MongoDB connection string.
#   Local install : mongodb://localhost:27017/
#   MongoDB Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/

# Database name used by the application.
DB_NAME=movie_recommender

# Milliseconds to wait for a MongoDB server before giving up.
MONGODB_TIMEOUT_MS=5000

# MovieLens Latest Small archive (defaults shown).
DATASET_URL=https://files.grouplens.org/datasets/movielens/ml-latest-small.zip

# Directory where the zip and the CSV files are cached.
DATA_DIR=data

# Default recommendation depth used by the API and the self-check.
TOP_N=10
TOP_K=10

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
